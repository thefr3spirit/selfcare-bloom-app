# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # Prevent pod frameworks from embedding provisioning profiles (causes exportArchive errors)
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      # Remove unsupported -G flag (added by gRPC-Core, not supported on Apple ARM64)
      ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS'].each do |key|
        flags = config.build_settings[key]
        if flags.is_a?(Array)
          config.build_settings[key] = flags.reject { |f| f.to_s.strip =~ /^-G\d*$/ }
        elsif flags.is_a?(String)
          config.build_settings[key] = flags.gsub(/-G\d*\s*/, '').strip
        end
      end
    end
  end

  # Also patch xcconfig files on disk (gRPC sets -G in xcconfig, not just pbxproj)
  Dir.glob(File.join(installer.config.installation_root, 'Pods', '**', '*.xcconfig')).each do |xcconfig_path|
    content = File.read(xcconfig_path)
    if content.match?(/-G\d*/)
      File.write(xcconfig_path, content.gsub(/-G\d*\s*/, '').squeeze(' '))
    end
  end

  # Fix for CocoaPods/Xcode 16+ generated framework scripts:
  # (a) set -u crashes when $source is unset; set +u silences it BUT then an empty
  #     $source causes `ditto "" destination` which copies the cwd (the ios/ dir)
  #     into Runner.app/Frameworks/ — causing App Store rejection.
  # Fix both: disable set -u AND guard every `ditto "${source}"` call.
  Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', '*', '*.sh')).each do |script|
    content = File.read(script)
    modified = false

    # (a) Disable strict unbound-variable mode
    if content.include?('set -u')
      content = content.gsub(/^set -u$/, 'set +u')
      modified = true
    end

    # (b) Guard ditto calls that use ${source} — skip if source resolved to empty
    if content.include?('ditto "${source}"') && !content.include?('CM_SOURCE_GUARD')
      content = content.gsub(
        /([ \t]*)(ditto\s+"\$\{source\}")/,
        "\\1[ -z \"${source:-}\" ] && { echo \"CM_SOURCE_GUARD: skipping unresolved ${BASENAME}\"; return; }\n\\1\\2"
      )
      modified = true
    end

    if modified
      File.write(script, content)
      puts "Patched #{File.basename(script)}"
    end
  end

  # Inject Info.plist into Flutter.framework slices — required by Xcode 26+.
  # flutter assemble runs BEFORE pod install (Flutter's build order), so
  # ios/Flutter/Flutter.xcframework already exists when this hook runs.
  # chmod is required — engine-cache copies are read-only on some CI environments.
  xcfw_base = File.expand_path('Flutter/Flutter.xcframework', File.dirname(__FILE__))
  if File.directory?(xcfw_base)
    Dir.glob("#{xcfw_base}/**/*.framework").each do |fw|
      plist = File.join(fw, 'Info.plist')
      next if File.exist?(plist)
      system("chmod -R u+w '#{fw}'")
      File.write(plist, <<~XML)
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0"><dict>
          <key>CFBundleExecutable</key><string>Flutter</string>
          <key>CFBundleIdentifier</key><string>io.flutter.flutter</string>
          <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
          <key>CFBundleName</key><string>Flutter</string>
          <key>CFBundlePackageType</key><string>FMWK</string>
          <key>CFBundleShortVersionString</key><string>1.0</string>
          <key>CFBundleVersion</key><string>1</string>
          <key>MinimumOSVersion</key><string>15.0</string>
        </dict></plist>
      XML
      puts "Injected Info.plist into #{fw}"
    end
  else
    puts "Warning: Flutter.xcframework not found at #{xcfw_base} — skipping Info.plist injection"
  end

  # Patch Pods-Runner-frameworks.sh to inject Info.plist into Flutter.framework
  # AT EMBED TIME — this code appended to the script runs inside the
  # [CP] Embed Pods Frameworks build phase during xcodebuild archive, AFTER the
  # framework has been copied to Runner.app/Frameworks but BEFORE the Validate phase.
  # This survives flutter assemble re-running (which overwrites ios/Flutter) because
  # it patches the ALREADY-EMBEDDED copy using Xcode's own build environment variables.
  fw_script = File.join(installer.sandbox.root, 'Target Support Files', 'Pods-Runner', 'Pods-Runner-frameworks.sh')
  if File.exist?(fw_script)
    content = File.read(fw_script)
    additions = ''

    unless content.include?('CM_FLUTTER_PLIST_INJECT')
      # App.framework (Flutter's own compiled-Dart-code framework, produced
      # fresh by `flutter assemble` on every build — distinct from the
      # engine's Flutter.xcframework) needs the exact same treatment: Xcode
      # 26+ / App Store Connect rejects any embedded framework missing a
      # MinimumOSVersion in its Info.plist ("Invalid MinimumOSVersion...
      # MinimumOSVersion in 'Runner.app/Frameworks/App.framework' is ''" /
      # "Missing Info.plist value... 'MinimumOSVersion' ... is required"),
      # confirmed via a real upload rejection.
      flutter_plist_xml = '<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd"><plist version="1.0"><dict><key>CFBundleExecutable</key><string>Flutter</string><key>CFBundleIdentifier</key><string>io.flutter.flutter</string><key>CFBundleInfoDictionaryVersion</key><string>6.0</string><key>CFBundleName</key><string>Flutter</string><key>CFBundlePackageType</key><string>FMWK</string><key>CFBundleShortVersionString</key><string>1.0</string><key>CFBundleVersion</key><string>1</string><key>MinimumOSVersion</key><string>15.0</string></dict></plist>'
      app_plist_xml = '<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd"><plist version="1.0"><dict><key>CFBundleExecutable</key><string>App</string><key>CFBundleIdentifier</key><string>io.flutter.flutter.app</string><key>CFBundleInfoDictionaryVersion</key><string>6.0</string><key>CFBundleName</key><string>App</string><key>CFBundlePackageType</key><string>FMWK</string><key>CFBundleShortVersionString</key><string>1.0</string><key>CFBundleVersion</key><string>1</string><key>MinimumOSVersion</key><string>15.0</string></dict></plist>'
      additions += <<~BASH

        # CM_FLUTTER_PLIST_INJECT: Xcode 26+ requires Info.plist (with
        # MinimumOSVersion) in embedded Flutter.framework AND App.framework.
        # Runs after all install_framework calls above, inside [CP] Embed Pods Frameworks.
        for _cm_base in "${TARGET_BUILD_DIR}" "${BUILT_PRODUCTS_DIR}"; do
          _cm_fw="${_cm_base}/${FRAMEWORKS_FOLDER_PATH}/Flutter.framework"
          if [ -d "${_cm_fw}" ] && [ ! -f "${_cm_fw}/Info.plist" ]; then
            printf '%s' '#{flutter_plist_xml}' > "${_cm_fw}/Info.plist" \
              && echo "CM_FLUTTER_PLIST_INJECT: patched ${_cm_fw}" \
              || echo "CM_FLUTTER_PLIST_INJECT: FAILED at ${_cm_fw}"
          fi
          _cm_app_fw="${_cm_base}/${FRAMEWORKS_FOLDER_PATH}/App.framework"
          if [ -d "${_cm_app_fw}" ] && [ ! -f "${_cm_app_fw}/Info.plist" ]; then
            printf '%s' '#{app_plist_xml}' > "${_cm_app_fw}/Info.plist" \
              && echo "CM_FLUTTER_PLIST_INJECT: patched ${_cm_app_fw}" \
              || echo "CM_FLUTTER_PLIST_INJECT: FAILED at ${_cm_app_fw}"
          fi
        done
      BASH
    end

    # A CocoaPods/Xcode embed-script bug (see the set +u / ditto guard above)
    # can copy the entire ios/ build directory — including ios/.symlinks/, a
    # build-time-only symlink farm Flutter's podhelper creates so Pods can
    # reference plugin source without copying it — into Runner.app/Frameworks/.
    # Those symlinks point at build-machine paths that don't resolve inside
    # the sealed bundle, so codesign's own validation fails ("invalid
    # destination for symbolic link in bundle"), and App Store Connect
    # rejects the upload with an unrelated-sounding "No architectures in the
    # binary" error. Must run here (before final app signing), not after
    # archiving — removing files from an already-signed bundle invalidates
    # its signature instead of fixing anything.
    unless content.include?('CM_REMOVE_SYMLINKS_JUNK')
      additions += <<~BASH

        # CM_REMOVE_SYMLINKS_JUNK: strip stray .symlinks/ pollution from the
        # embedded Frameworks folder before the bundle gets signed.
        for _cm_fw_dir in "${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}" "${BUILT_PRODUCTS_DIR}/${FRAMEWORKS_FOLDER_PATH}"; do
          if [ -e "${_cm_fw_dir}/.symlinks" ]; then
            echo "CM_REMOVE_SYMLINKS_JUNK: removing ${_cm_fw_dir}/.symlinks"
            rm -rf "${_cm_fw_dir}/.symlinks"
          fi
        done
      BASH
    end

    # Confirmed via a real shipped IPA (Xcode 26.3 archive): the same
    # ditto/set-u bug can go further than just .symlinks/ and copy the
    # *entire* ios/ source directory — Podfile, Podfile.lock, .gitignore,
    # ExportOptions-ci.plist, Pods/, and a whole Runner/ subfolder
    # containing the UNPROCESSED Info.plist template (raw, un-substituted
    # $(PRODUCT_BUNDLE_IDENTIFIER)/$(EXECUTABLE_NAME)/etc. macros) — into
    # Runner.app/Frameworks/. Apple's upload validator chokes on that
    # bogus "Runner"-named entry (no real Mach-O executable inside it,
    # and/or an Info.plist with a literal unresolved bundle-id macro) and
    # rejects with the unrelated-sounding "No architectures in the binary"
    # error, or "Cannot determine the Apple ID from Bundle ID
    # '$(PRODUCT_BUNDLE_IDENTIFIER)'". Only *.framework/*.dylib/*.bundle
    # belong directly under Frameworks/ — delete anything else found there.
    unless content.include?('CM_WHITELIST_FRAMEWORKS_DIR')
      additions += <<~BASH

        # CM_WHITELIST_FRAMEWORKS_DIR: strip any non-framework junk (stray
        # copies of ios/ source files/dirs) from the embedded Frameworks
        # folder before the bundle gets signed.
        for _cm_fw_dir in "${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}" "${BUILT_PRODUCTS_DIR}/${FRAMEWORKS_FOLDER_PATH}"; do
          if [ -d "${_cm_fw_dir}" ]; then
            find "${_cm_fw_dir}" -mindepth 1 -maxdepth 1 ! -name "*.framework" ! -name "*.dylib" ! -name "*.bundle" -print0 | while IFS= read -r -d '' _cm_junk; do
              echo "CM_WHITELIST_FRAMEWORKS_DIR: removing stray ${_cm_junk}"
              rm -rf "${_cm_junk}"
            done
          fi
        done
      BASH
    end

    if additions.empty?
      puts "Pods-Runner-frameworks.sh already has all patches"
    else
      applied = []
      applied << 'plist inject' if additions.include?('CM_FLUTTER_PLIST_INJECT')
      applied << 'symlinks cleanup' if additions.include?('CM_REMOVE_SYMLINKS_JUNK')
      applied << 'frameworks-dir whitelist' if additions.include?('CM_WHITELIST_FRAMEWORKS_DIR')
      File.write(fw_script, content + additions)
      puts "Patched Pods-Runner-frameworks.sh (#{applied.join(', ')})"
    end
  else
    puts "WARNING: Pods-Runner-frameworks.sh not found at #{fw_script}"
  end
end
